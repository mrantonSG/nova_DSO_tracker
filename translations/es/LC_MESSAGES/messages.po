msgstr "¡Sesión iniciada con éxito!"

#: nova/blueprints/core.py:368
msgid "Invalid username or password."
msgstr "Nombre de usuario o contraseña no válidos."

#: nova/blueprints/core.py:376
msgid "Single Sign-On is not applicable in single-user mode."
msgstr ""
"El inicio de sesión único (SSO) no es aplicable en modo de un solo "
