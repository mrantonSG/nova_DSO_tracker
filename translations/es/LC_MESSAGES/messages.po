#: nova/blueprints/core.py:384
msgid "SSO Error: No token provided."
msgstr "Error de SSO: No se proporcionó ningún token."

#: nova/blueprints/core.py:390
msgid "SSO Error: SSO is not configured on the server."
msgstr "Error de SSO: SSO no está configurado en el servidor."

#: nova/blueprints/core.py:409
#, python-format
msgid "Welcome back, %(username)s!"
msgstr "¡Bienvenido de nuevo, %(username)s!"

#: nova/blueprints/core.py:412
#, python-format
msgid "SSO Error: User '%(username)s' not found or is disabled in Nova."
msgstr ""
"Error de SSO: Usuario '%(username)s' no encontrado o está deshabilitado "
"en Nova."

#: nova/blueprints/core.py:416
msgid "SSO Error: The login link has expired. Please try again from WordPress."
msgstr ""
"Error de SSO: El enlace de inicio de sesión ha expirado. Por favor, "
"inténtelo de nuevo desde WordPress."

#: nova/blueprints/core.py:419
msgid "SSO Error: Invalid login token."
msgstr "Error de SSO: Token de inicio de sesión no válido."

#: nova/blueprints/core.py:638
#, python-format
msgid "Could not find user '%(username)s' in the database."
msgstr "No se pudo encontrar el usuario '%(username)s' en la base de datos."

#: nova/blueprints/core.py:727
msgid "Warning: Horizon Mask was invalid and was ignored."
msgstr "Advertencia: La máscara de horizonte no era válida y se ignoró."

#: nova/blueprints/core.py:757
msgid ""
"Cannot delete your last location. You must have at least one location "
"configured."
msgstr ""
"No se puede eliminar su última ubicación. Debe tener al menos una "
"ubicación configurada."

#: nova/blueprints/core.py:762
msgid ""
"Cannot deactivate your only active location. You must keep at least one "
"active location."
msgstr ""
"No se puede desactivar su única ubicación activa. Debe mantener al menos "
"una ubicación activa."

#: nova/blueprints/core.py:808
#, python-format
msgid "Warning: Horizon Mask for '%(location_name)s' was invalid and ignored."
msgstr ""
"Advertencia: La máscara de horizonte para '%(location_name)s' no era "
"válida y se ignoró."

#: nova/blueprints/core.py:898
#, python-format
msgid "%(message)s updated successfully."
msgstr "%(message)s actualizado con éxito."

#: nova/blueprints/core.py:900
#, python-format
msgid ""
"Cannot delete object '%(name)s': it is still used by %(sessions)d "
"session(s) and %(projects)d project(s)."
msgstr ""
"No se puede eliminar el objeto '%(name)s': todavía lo usan %(sessions)d "
"sesión(es) y %(projects)d proyecto(s)."

#: nova/blueprints/core.py:904
#, python-format
msgid "Cannot delete location '%(name)s': it is used by %(sessions)d session(s)."
msgstr ""
"No se puede eliminar la ubicación '%(name)s': la usan %(sessions)d "
"sesión(es)."

