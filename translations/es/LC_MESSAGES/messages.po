msgstr "Precisión de cálculo:"

#: templates/config_form.html:181
msgid "High (10 min samples)"
msgstr "Alta (muestras de 10 min)"

#: templates/config_form.html:182
msgid "Default (15 min samples)"
msgstr "Predeterminada (muestras de 15 min)"

#: templates/config_form.html:183
msgid "Balanced (20 min samples)"
