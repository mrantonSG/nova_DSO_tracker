#: nova/blueprints/sync_tokens.py:79
msgid "This form expired. Please try again."
msgstr "Este formulario ha caducado. Inténtalo de nuevo."

#: nova/blueprints/sync_tokens.py:127
msgid "This app and the server speak different sync versions. Update one of them."
msgstr ""
"Esta app y el servidor usan versiones de sincronización distintas. "
"Actualiza uno de ellos."

#: nova/blueprints/sync_tokens.py:129
msgid "This server doesn't support sync — it needs a newer Nova version."
msgstr ""
"Este servidor no admite la sincronización — necesita una versión más "
"reciente de Nova."

#: nova/blueprints/sync_tokens.py:131
msgid "The server already has this file."
msgstr "El servidor ya tiene este archivo."

#: nova/blueprints/sync_tokens.py:133
msgid "The sync token was rejected."
msgstr "El token de sincronización fue rechazado."

#: nova/blueprints/sync_tokens.py:135
msgid "This token has been revoked."
msgstr "Este token ha sido revocado."

#: nova/blueprints/sync_tokens.py:137
msgid "The guest account can't sync."
msgstr "La cuenta de invitado no puede sincronizar."

#: nova/blueprints/sync_tokens.py:139 nova/blueprints/sync_tokens.py:489
#: nova/blueprints/sync_tokens.py:507 templates/sync_tokens.html:282
msgid "Not connected to a server."
msgstr "No conectado a un servidor."

#: nova/blueprints/sync_tokens.py:141 templates/sync_tokens.html:228
msgid "Download from the server first."
msgstr "Descarga primero desde el servidor."

#: nova/blueprints/sync_tokens.py:143
msgid "This server has no data yet — import your YAML files there first."
msgstr "Este servidor aún no tiene datos: importa primero allí tus archivos YAML."

#: nova/blueprints/sync_tokens.py:145
msgid "Local data was replaced from a YAML import."
msgstr "Los datos locales se reemplazaron mediante una importación YAML."

#: nova/blueprints/sync_tokens.py:147
msgid "The server's data was replaced from a YAML import."
msgstr "Los datos del servidor se reemplazaron mediante una importación YAML."

#: nova/blueprints/sync_tokens.py:149
msgid "A sync is already running."
msgstr "Ya hay una sincronización en curso."

#: nova/blueprints/sync_tokens.py:151
msgid "The data changed during sync — retrying."
msgstr "Los datos cambiaron durante la sincronización: reintentando."

#: nova/blueprints/sync_tokens.py:153
#, python-format
msgid "This sync would delete %(deletions)s of %(records)s records."
msgstr "Esta sincronización eliminaría %(deletions)s de %(records)s registros."

#: nova/blueprints/sync_tokens.py:157
#, python-format
msgid "Your computer's clock is off by %(minutes)s minutes."
msgstr "El reloj de tu ordenador está desviado %(minutes)s minutos."

#: nova/blueprints/sync_tokens.py:159
msgid "The server sent an unreadable response."
msgstr "El servidor envió una respuesta ilegible."

#: nova/blueprints/sync_tokens.py:161
msgid "This server uses data shapes this app doesn't know."
msgstr "Este servidor usa estructuras de datos que esta app no reconoce."

#: nova/blueprints/sync_tokens.py:163
msgid "The server sent a record this app can't import."
msgstr "El servidor envió un registro que esta app no puede importar."

#: nova/blueprints/sync_tokens.py:165
msgid "A session record can't be matched."
msgstr "No se pudo emparejar un registro de sesión."

#: nova/blueprints/sync_tokens.py:167
msgid "A file reference in the sync is invalid."
msgstr "Una referencia de archivo en la sincronización no es válida."

#: nova/blueprints/sync_tokens.py:169
msgid "A file is too large to sync."
msgstr "Un archivo es demasiado grande para sincronizar."

#: nova/blueprints/sync_tokens.py:171
msgid "A file failed its checksum."
msgstr "Falló la suma de comprobación de un archivo."

#: nova/blueprints/sync_tokens.py:173
msgid "Not enough disk space."
msgstr "No hay suficiente espacio en disco."

#: nova/blueprints/sync_tokens.py:175 nova/blueprints/sync_tokens.py:449
msgid "Could not reach the server."
msgstr "No se pudo conectar con el servidor."

#: nova/blueprints/sync_tokens.py:177
msgid "The sync failed unexpectedly."
msgstr "La sincronización falló de forma inesperada."

#: nova/blueprints/sync_tokens.py:179
msgid "The last sync was interrupted. Run Sync now to finish."
msgstr ""
"La última sincronización se interrumpió. Ejecuta «Sincronizar ahora» para"
" terminarla."

#: nova/blueprints/sync_tokens.py:181
msgid "Type REPLACE to continue."
msgstr "Escribe REPLACE para continuar."

#: nova/blueprints/sync_tokens.py:182
#, python-format
msgid "Sync failed (%(code)s)."
msgstr "Error de sincronización (%(code)s)."

#: nova/blueprints/sync_tokens.py:195
#, python-format
msgid ""
"A session's link to project \"%(name)s\" was not synced: that project is "
"not part of this account."
msgstr ""
"El vínculo de una sesión con el proyecto «%(name)s» no se sincronizó: ese"
" proyecto no forma parte de esta cuenta."

#: nova/blueprints/sync_tokens.py:198
